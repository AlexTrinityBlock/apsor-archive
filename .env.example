# Required only for AI answers and AI summaries. Leave empty to use the
# deterministic extractive summary fallback and disable agent answers. The
# Settings UI can store an encrypted key in the database instead; the database
# wins.
APSOR_DEEPSEEK_API_KEY=

# Optional Fernet master key. When unset, data/.secret_key is created with 0600.
# APSOR_SECRET_KEY=

# Owner session cookie. Set true when served over HTTPS (Cloudflare compose does).
APSOR_COOKIE_SECURE=false
APSOR_SESSION_TTL_HOURS=720

# Cloudflare deployment only.
APSOR_PUBLIC_HOST=api.example.com

# Optional overrides.
# APSOR_DATABASE_URL=postgresql+psycopg://apsor:apsor@127.0.0.1:55432/apsor_archive
# APSOR_CACHE_URL=redis://127.0.0.1:56379/0
# APSOR_TIMEZONE=Asia/Taipei
# APSOR_EMBEDDING_PROVIDER=openai
# APSOR_EMBEDDING_BASE_URL=https://api.openai.com/v1
# APSOR_EMBEDDING_MODEL=text-embedding-3-small
# APSOR_EMBEDDING_DIMENSION=1536
# APSOR_EMBEDDING_API_KEY=
