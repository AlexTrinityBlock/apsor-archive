# Required only for AI answers and AI summaries. Leave empty to use the
# deterministic extractive summary fallback and disable /ask. The Settings UI
# can store an encrypted key in the database instead; the database wins.
DENDRO_DEEPSEEK_API_KEY=

# Optional Fernet master key. When unset, data/.secret_key is created with 0600.
# DENDRO_SECRET_KEY=

# Owner session cookie. Set true when served over HTTPS (Cloudflare compose does).
DENDRO_COOKIE_SECURE=false
DENDRO_SESSION_TTL_HOURS=720

# Cloudflare deployment only.
DENDRO_PUBLIC_HOST=api.example.com

# Optional overrides.
# DENDRO_DATABASE_URL=postgresql+psycopg://dendro:dendro@127.0.0.1:55432/dendromatrix
# DENDRO_CACHE_URL=redis://127.0.0.1:56379/0
# DENDRO_TIMEZONE=Asia/Taipei
# DENDRO_EMBEDDING_PROVIDER=openai
# DENDRO_EMBEDDING_BASE_URL=https://api.openai.com/v1
# DENDRO_EMBEDDING_MODEL=text-embedding-3-small
# DENDRO_EMBEDDING_DIMENSION=1536
# DENDRO_EMBEDDING_API_KEY=
