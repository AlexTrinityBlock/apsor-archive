{
  "name": "apsor-archive-frontend",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.6",
  "scripts": {
    "pdf-assets": "bun scripts/copy-pdfjs-assets.mjs",
    "dev": "bun run pdf-assets && vite",
    "build": "bun run pdf-assets && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "i18n:check": "bun scripts/check-i18n.ts",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "test": "bun test",
    "lint:fix": "eslint . --fix",
    "api:generate": "orval",
    "api:generate:live": "VITE_OPENAPI_SPEC=http://127.0.0.1:8000/openapi.json orval",
    "api:watch": "orval --watch"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.104.5",
    "chart.js": "^4",
    "docx-preview": "0.4.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.61.0",
    "pdfjs-dist": "6.3.289",
    "plotly.js-dist-min": "^4.3.0",
    "pptxviewjs": "^1.1.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "react-pdf": "11.0.0",
    "react-router-dom": "^7.18.4",
    "react-zoom-pan-pinch": "4.2.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "4.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "fast-uri": "^3.1.9",
    "undici": "^7.30.1",
    "minimatch": "^11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.5",
    "@types/plotly.js": "^3.0.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsdoc": "^65.4.2",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "orval": "^8.44.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5"
  },
  "patchedDependencies": {
    "pptxviewjs@1.1.9": "patches/pptxviewjs@1.1.9.patch"
  }
}
